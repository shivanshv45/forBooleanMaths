NODE_ENV=development
PORT=4000

MONGO_URI=mongodb://localhost:27017/boolean_slack
REDIS_URL=redis://localhost:6379

QUEUE_NAME=slack:reports

# Slack allows roughly one webhook message per second
RATE_LIMIT_MS=1000
MAX_ATTEMPTS=5
DEFAULT_RETRY_AFTER_MS=5000

CRON_SCHEDULE=0 9 * * *
CRON_TIMEZONE=Asia/Kolkata

# the brief asks for 20%. raise it when demoing so the retry path fires
MOCK_FAILURE_RATE=0.2
MOCK_RETRY_AFTER_SECONDS=3

CORS_ORIGIN=http://localhost:5173

# real slack webhooks for the seed, falls back to the local mock when unset
SLACK_WEBHOOK_1=
SLACK_WEBHOOK_2=
SLACK_WEBHOOK_3=
SLACK_WEBHOOK_4=
SLACK_WEBHOOK_5=
